{
  "id": "feature-showcase",
  "name": "SCLPLAPI Feature Showcase",
  "description": "A comprehensive workflow demonstrating every SCLPLL feature. Uses JSONPlaceholder API for all operations.",
  "steps": [
    {
      "id": "fetch_users",
      "name": "fetch_users",
      "type": "request",
      "config": {
        "inline_request": {
          "method": "GET",
          "url": "{{base_url}}/users",
          "headers": {
            "Accept": "application/json",
            "X-API-Version": "{{api_version}}"
          }
        }
      },
      "output_variable": "users_data"
    },
    {
      "id": "fetch_posts",
      "name": "fetch_posts",
      "type": "request",
      "config": {
        "inline_request": {
          "method": "GET",
          "url": "{{base_url}}/posts",
          "headers": {
            "Accept": "application/json"
          }
        }
      },
      "output_variable": "posts_data"
    },
    {
      "id": "fetch_todos",
      "name": "fetch_todos",
      "type": "request",
      "config": {
        "inline_request": {
          "method": "GET",
          "url": "{{base_url}}/todos",
          "headers": {
            "Accept": "application/json"
          }
        }
      },
      "output_variable": "todos_data"
    },
    {
      "id": "get_first_user",
      "name": "get_first_user",
      "type": "function",
      "config": {
        "function_name": "Extract First User"
      },
      "depends_on": [
        "fetch_users"
      ],
      "output_variable": "first_user"
    },
    {
      "id": "get_user_address",
      "name": "get_user_address",
      "type": "function",
      "config": {
        "function_name": "Extract User Address"
      },
      "depends_on": [
        "fetch_users"
      ],
      "output_variable": "user_address"
    },
    {
      "id": "create_post",
      "name": "create_post",
      "type": "request",
      "config": {
        "inline_request": {
          "method": "POST",
          "url": "{{base_url}}/posts",
          "headers": {
            "Content-Type": "application/json",
            "X-Admin-Email": "{{admin_email}}"
          },
          "body": "{\"title\": \"New Feature Post\", \"body\": \"Testing POST with body\", \"userId\": 1}"
        }
      },
      "depends_on": [
        "fetch_users"
      ],
      "output_variable": "new_post"
    },
    {
      "id": "update_post",
      "name": "update_post",
      "type": "request",
      "config": {
        "inline_request": {
          "method": "PUT",
          "url": "{{base_url}}/posts/1",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "{\"id\": 1, \"title\": \"Updated Title\", \"body\": \"Updated body content\", \"userId\": 1}"
        }
      },
      "depends_on": [
        "create_post"
      ],
      "output_variable": "updated_post"
    },
    {
      "id": "delete_resource",
      "name": "delete_resource",
      "type": "request",
      "config": {
        "inline_request": {
          "method": "DELETE",
          "url": "{{base_url}}/posts/1",
          "headers": {}
        }
      },
      "depends_on": [
        "create_post"
      ],
      "output_variable": "delete_result"
    },
    {
      "id": "process_users",
      "name": "process_users",
      "type": "function",
      "config": {
        "function_name": "Process User List"
      },
      "depends_on": [
        "fetch_users"
      ],
      "output_variable": "processed_users"
    },
    {
      "id": "batch_fetch",
      "name": "batch_fetch",
      "type": "request",
      "config": {
        "inline_request": {
          "method": "GET",
          "url": "{{base_url}}/posts/{{_index}}",
          "headers": {}
        }
      },
      "depends_on": [
        "fetch_posts"
      ],
      "output_variable": "batch_results",
      "repeat_count": 3
    },
    {
      "id": "success_handler",
      "name": "success_handler",
      "type": "function",
      "config": {
        "function_name": "Handle Success"
      },
      "depends_on": [
        "create_post"
      ],
      "output_variable": "success_result",
      "condition": "{{create_post.status_code}} == 201"
    },
    {
      "id": "error_handler",
      "name": "error_handler",
      "type": "function",
      "config": {
        "function_name": "Handle Error"
      },
      "depends_on": [
        "create_post"
      ],
      "output_variable": "error_result",
      "condition": "{{create_post.status_code}} != 201"
    },
    {
      "id": "rate_limited_fetch",
      "name": "rate_limited_fetch",
      "type": "request",
      "config": {
        "inline_request": {
          "method": "GET",
          "url": "{{base_url}}/users/{{_index}}",
          "headers": {}
        }
      },
      "depends_on": [
        "fetch_users"
      ],
      "output_variable": "rate_limited_data",
      "semaphore": 2,
      "repeat_count": 5
    },
    {
      "id": "merge_data",
      "name": "merge_data",
      "type": "function",
      "config": {
        "function_name": "Merge All Data"
      },
      "depends_on": [
        "fetch_users",
        "fetch_posts",
        "fetch_todos"
      ],
      "output_variable": "merged_data"
    },
    {
      "id": "analyze",
      "name": "analyze",
      "type": "function",
      "config": {
        "function_name": "Analyze Data"
      },
      "depends_on": [
        "merge_data",
        "process_users"
      ],
      "output_variable": "analytics"
    },
    {
      "id": "generate_report",
      "name": "generate_report",
      "type": "function",
      "config": {
        "function_name": "Generate Showcase Report"
      },
      "depends_on": [
        "analyze",
        "success_handler",
        "error_handler"
      ],
      "output_variable": "final_report"
    }
  ],
  "variables": {
    "base_url": "https://jsonplaceholder.typicode.com",
    "api_version": "1",
    "admin_email": "admin@example.com"
  }
}
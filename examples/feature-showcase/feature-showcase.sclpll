# SCLPLAPI Feature Showcase
# Demonstrates ALL SCLPLL features in a single realistic workflow
#
# Features used:
#   - @workflow, @base_url, @var directives
#   - GET, POST, PUT, DELETE requests
#   - Headers and Body payloads
#   - Dependencies (<-) and Output variables (->)
#   - Dot notation ({{step.field.subfield}})
#   - @foreach loops
#   - @repeat loops
#   - @when conditions
#   - @semaphore rate limiting
#   - Function steps

@workflow feature-showcase "SCLPLAPI Feature Showcase"
    A comprehensive workflow demonstrating every SCLPLL feature.
    Uses JSONPlaceholder API for all operations.

@base_url https://jsonplaceholder.typicode.com
@var api_version = 1
@var admin_email = admin@example.com

# ============================================================
# PHASE 1: Independent GET requests (parallel execution)
# ============================================================

@step fetch_users -> users_data
    request GET {{base_url}}/users
    header Accept: application/json
    header X-API-Version: {{api_version}}

@step fetch_posts -> posts_data
    request GET {{base_url}}/posts
    header Accept: application/json

@step fetch_todos -> todos_data
    request GET {{base_url}}/todos
    header Accept: application/json

# ============================================================
# PHASE 2: Dot notation access (nested JSON extraction)
# ============================================================

@step get_first_user <- fetch_users -> first_user
    func Extract First User

@step get_user_address <- fetch_users -> user_address
    func Extract User Address

# ============================================================
# PHASE 3: POST request with body payload
# ============================================================

@step create_post <- fetch_users -> new_post
    request POST {{base_url}}/posts
    header Content-Type: application/json
    header X-Admin-Email: {{admin_email}}
    body {"title": "New Feature Post", "body": "Testing POST with body", "userId": 1}

# ============================================================
# PHASE 4: PUT request (update)
# ============================================================

@step update_post <- create_post -> updated_post
    request PUT {{base_url}}/posts/1
    header Content-Type: application/json
    body {"id": 1, "title": "Updated Title", "body": "Updated body content", "userId": 1}

# ============================================================
# PHASE 5: DELETE request
# ============================================================

@step delete_resource <- create_post -> delete_result
    request DELETE {{base_url}}/posts/1

# ============================================================
# PHASE 6: @foreach loop (iterate over collection)
# ============================================================

@step process_users <- fetch_users -> processed_users
    func Process User List

# ============================================================
# PHASE 7: @repeat loop (batch operations)
# ============================================================

@step batch_fetch <- fetch_posts -> batch_results
    @repeat 3
    request GET {{base_url}}/posts/{{_index}}

# ============================================================
# PHASE 8: @when conditional execution
# ============================================================

@step success_handler <- create_post -> success_result
    @when {{create_post.status_code}} == 201
    func Handle Success

@step error_handler <- create_post -> error_result
    @when {{create_post.status_code}} != 201
    func Handle Error

# ============================================================
# PHASE 9: @semaphore rate limiting
# ============================================================

@step rate_limited_fetch <- fetch_users -> rate_limited_data
    @semaphore 2
    @repeat 5
    request GET {{base_url}}/users/{{_index}}

# ============================================================
# PHASE 10: Merge and analyze (depends on multiple steps)
# ============================================================

@step merge_data <- fetch_users, fetch_posts, fetch_todos -> merged_data
    func Merge All Data

# ============================================================
# PHASE 11: Analytics with dot notation
# ============================================================

@step analyze <- merge_data, process_users -> analytics
    func Analyze Data

# ============================================================
# PHASE 12: Generate final report
# ============================================================

@step generate_report <- analyze, success_handler, error_handler -> final_report
    func Generate Showcase Report

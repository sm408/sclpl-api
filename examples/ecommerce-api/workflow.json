{
  "id": "ecommerce-api",
  "name": "E-Commerce API Testing Workflow",
  "description": "Tests a complete e-commerce flow: products, categories, orders, payments, inventory updates, and receipt generation.",
  "steps": [
    {
      "id": "fetch_products",
      "name": "fetch_products",
      "type": "request",
      "config": {
        "inline_request": {
          "method": "GET",
          "url": "{{base_url}}/posts?_limit=5",
          "headers": {}
        }
      },
      "output_variable": "products_data"
    },
    {
      "id": "fetch_categories",
      "name": "fetch_categories",
      "type": "request",
      "config": {
        "inline_request": {
          "method": "GET",
          "url": "{{base_url}}/albums?_limit=5",
          "headers": {}
        }
      },
      "output_variable": "categories_data"
    },
    {
      "id": "create_order",
      "name": "create_order",
      "type": "function",
      "config": {
        "function_name": "Process Order"
      },
      "depends_on": [
        "fetch_products",
        "fetch_categories"
      ],
      "output_variable": "order"
    },
    {
      "id": "process_payment",
      "name": "process_payment",
      "type": "request",
      "config": {
        "inline_request": {
          "method": "POST",
          "url": "{{base_url}}/posts",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "{\"orderId\": \"{{order.order_id}}\", \"amount\": \"{{order.total}}\", \"method\": \"credit_card\", \"status\": \"completed\"}"
        }
      },
      "depends_on": [
        "create_order"
      ],
      "output_variable": "payment_data"
    },
    {
      "id": "update_inventory",
      "name": "update_inventory",
      "type": "function",
      "config": {
        "function_name": "Update Inventory"
      },
      "depends_on": [
        "create_order"
      ],
      "output_variable": "inventory_update"
    },
    {
      "id": "generate_receipt",
      "name": "generate_receipt",
      "type": "function",
      "config": {
        "function_name": "Generate Receipt"
      },
      "depends_on": [
        "process_payment",
        "update_inventory"
      ],
      "output_variable": "receipt"
    }
  ],
  "variables": {
    "base_url": "https://jsonplaceholder.typicode.com"
  }
}

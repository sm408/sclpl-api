# E-Commerce API Testing Workflow
# Tests a full e-commerce flow: products, categories, orders, payments, inventory

@workflow ecommerce-api "E-Commerce API Testing Workflow"
    Tests a complete e-commerce flow against a mock API.
    Fetches products and categories, creates an order,
    processes payment, updates inventory, and generates a receipt.

@base_url https://jsonplaceholder.typicode.com

# ============================================================
# PHASE 1: Independent fetches (all run in parallel)
# ============================================================

@step fetch_products -> products_data
    request GET {{base_url}}/posts?_limit=5

@step fetch_categories -> categories_data
    request GET {{base_url}}/albums?_limit=5

# ============================================================
# PHASE 2: Order creation (depends on products and categories)
# ============================================================

@step create_order <- fetch_products, fetch_categories -> order
    func Process Order

# ============================================================
# PHASE 3: Payment processing (depends on order)
# ============================================================

@step process_payment <- create_order -> payment_data
    request POST {{base_url}}/posts
    header Content-Type: application/json
    body {"orderId": "{{order.order_id}}", "amount": "{{order.total}}", "method": "credit_card", "status": "completed"}

# ============================================================
# PHASE 4: Inventory update (depends on order)
# ============================================================

@step update_inventory <- create_order -> inventory_update
    func Update Inventory

# ============================================================
# PHASE 5: Receipt generation (depends on payment and inventory)
# ============================================================

@step generate_receipt <- process_payment, update_inventory -> receipt
    func Generate Receipt

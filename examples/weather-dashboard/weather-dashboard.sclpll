# Weather Dashboard
# Fetches current weather, forecast, and alerts, then generates a dashboard

@workflow weather-dashboard "Weather Dashboard"
    Fetches current weather conditions, forecast data,
    and weather alerts in parallel, then combines them
    into a unified dashboard view.

@var city = London

# ============================================================
# PHASE 1: Independent fetches (all run in parallel)
# ============================================================

@step fetch_current_weather -> current_weather
    request GET https://wttr.in/{{city}}?format=j1

@step fetch_forecast -> forecast_data
    request GET https://wttr.in/{{city}}?format=j1&num_of_days=3

@step fetch_alerts -> alerts_data
    request GET https://wttr.in/{{city}}?format=j1

# ============================================================
# PHASE 2: Dashboard generation (depends on all fetches)
# ============================================================

@step generate_dashboard <- fetch_current_weather, fetch_forecast, fetch_alerts -> dashboard
    func Generate Dashboard

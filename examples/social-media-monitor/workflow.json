{
  "id": "social-media-monitor",
  "name": "Social Media Monitor",
  "description": "Fetches posts and users, performs keyword-based sentiment analysis, and generates a monitoring report.",
  "steps": [
    {
      "id": "fetch_tweets",
      "name": "fetch_tweets",
      "type": "request",
      "config": {
        "inline_request": {
          "method": "GET",
          "url": "{{base_url}}/posts?_limit=20",
          "headers": {}
        }
      },
      "output_variable": "tweets_data"
    },
    {
      "id": "fetch_users",
      "name": "fetch_users",
      "type": "request",
      "config": {
        "inline_request": {
          "method": "GET",
          "url": "{{base_url}}/users",
          "headers": {}
        }
      },
      "output_variable": "users_data"
    },
    {
      "id": "analyze_sentiment",
      "name": "analyze_sentiment",
      "type": "function",
      "config": {
        "function_name": "Analyze Sentiment"
      },
      "depends_on": [
        "fetch_tweets",
        "fetch_users"
      ],
      "output_variable": "sentiment_analysis"
    },
    {
      "id": "generate_report",
      "name": "generate_report",
      "type": "function",
      "config": {
        "function_name": "Generate Monitor Report"
      },
      "depends_on": [
        "analyze_sentiment"
      ],
      "output_variable": "monitor_report"
    }
  ],
  "variables": {
    "base_url": "https://jsonplaceholder.typicode.com"
  }
}

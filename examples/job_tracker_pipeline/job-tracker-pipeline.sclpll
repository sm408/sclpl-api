# Job Application Tracker Pipeline
# Multi-step async pipeline: fetch data in parallel, merge, analyze, report.

@workflow job-tracker-pipeline "Job Application Tracker Pipeline"
    Multi-step async pipeline that fetches data from multiple endpoints
    in parallel, merges results, and generates a comprehensive report.

@base_url https://jsonplaceholder.typicode.com

# ============================================================
# PHASE 1: Independent fetches (all run in parallel)
# ============================================================

@step fetch_users -> users_data
    request GET {{base_url}}/users
    header Accept: application/json

@step fetch_posts -> posts_data
    request GET {{base_url}}/posts
    header Accept: application/json

@step fetch_comments -> comments_data
    request GET {{base_url}}/comments
    header Accept: application/json

@step fetch_todos -> todos_data
    request GET {{base_url}}/todos
    header Accept: application/json

# ============================================================
# PHASE 2: Merge & analyze (each waits on specific deps)
# ============================================================

@step merge_user_posts <- fetch_users, fetch_posts -> user_posts_merged
    func Merge User Posts

@step post_analytics <- fetch_posts, fetch_comments -> analytics_result
    func Post Analytics

@step user_todo_summary <- fetch_users, fetch_todos -> todo_summary
    func User Todo Summary

# ============================================================
# PHASE 3: Final report (waits for all phase 2 steps)
# ============================================================

@step generate_report <- merge_user_posts, post_analytics, user_todo_summary -> final_report
    func Generate Report

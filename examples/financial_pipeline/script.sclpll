# Financial Market Analysis Pipeline
# Fetches crypto prices, market data, and generates analysis
# Uses CoinGecko API (free, no API key required)

@workflow financial-market-analysis "Financial Market Analysis Pipeline"
    Fetches cryptocurrency prices and market data in parallel,
    merges results, and generates a comprehensive market analysis report.

@base_url https://api.coingecko.com/api/v3

# ============================================================
# PHASE 1: Independent fetches (all run in parallel)
# ============================================================

@step fetch_bitcoin -> bitcoin_data
    request GET {{base_url}}/simple/price?ids=bitcoin&vs_currencies=usd&include_24hr_change=true&include_market_cap=true

@step fetch_ethereum -> ethereum_data
    request GET {{base_url}}/simple/price?ids=ethereum&vs_currencies=usd&include_24hr_change=true&include_market_cap=true

@step fetch_top_coins -> top_coins_data
    request GET {{base_url}}/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=10&page=1

@step fetch_global_market -> global_data
    request GET {{base_url}}/global

# ============================================================
# PHASE 2: Processing (each waits on specific deps)
# ============================================================

# Merge Bitcoin and Ethereum prices
@step merge_prices <- fetch_bitcoin, fetch_ethereum -> merged_prices
    func Merge Crypto Prices

# Analyze top coins market data
@step analyze_market <- fetch_top_coins, fetch_global_market -> market_analysis
    func Analyze Market

# ============================================================
# PHASE 3: Final report (waits for all phase 2 steps)
# ============================================================

@step generate_report <- merge_prices, analyze_market -> final_report
    func Generate Financial Report

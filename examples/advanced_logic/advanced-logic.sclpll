# Advanced Logic Pipeline
# Demonstrates complex dependency chains with parallel and sequential stages

@workflow advanced-logic "Advanced Logic Pipeline"
    Demonstrates complex dependency chains with parallel and sequential stages

@var api_url = https://httpbin.org

# Step 1: Initialize configuration (independent)
@step init_config -> config_raw
    request GET {{api_url}}/get?stage=init

# Step 2: Fetch users (depends on config)
@step fetch_users <- init_config -> users_raw
    request GET {{api_url}}/get?resource=users

# Step 3: Fetch orders (depends on config, parallel with users)
@step fetch_orders <- init_config -> orders_raw
    request GET {{api_url}}/get?resource=orders

# Step 4: Enrich user data
@step enrich_users <- fetch_users
    func Enrich User Data

# Step 5: Enrich order data
@step enrich_orders <- fetch_orders
    func Enrich Order Data

# Step 6: Join users and orders
@step join_data <- enrich_users, enrich_orders
    func Join User Order Data

# Step 7: Generate dashboard
@step generate_dashboard <- join_data
    func Generate Dashboard

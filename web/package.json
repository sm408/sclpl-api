{
  "name": "sclplapi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "type-check": "vue-tsc --noEmit",
    "types:generate": "node --import tsx scripts/generate-types.ts",
    "types:check": "node --import tsx scripts/check-types-drift.ts"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "pinia": "^3.0.1",
    "@tanstack/vue-query": "^5.62.0",
    "primevue": "^4.5.0",
    "@primeuix/themes": "^1.0.0",
    "lucide-vue-next": "^0.469.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.8",
    "typescript": "~5.8.3",
    "vitest": "^3.1.4",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^17.4.4",
    "eslint": "^9.27.0",
    "@eslint/js": "^9.27.0",
    "typescript-eslint": "^8.33.0",
    "eslint-plugin-vue": "^10.2.0",
    "tsx": "^4.19.0",
    "openapi-typescript": "^7.8.0",
    "@types/node": "^22.15.0"
  }
}

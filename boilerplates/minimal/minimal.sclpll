# Minimal Workflow Template
# A bare-bones SCLPLL workflow to use as a starting point

@workflow minimal-workflow "Minimal Workflow"
    A minimal workflow template. Replace this with your own description.

@base_url https://jsonplaceholder.typicode.com

# ============================================================
# STEP 1: Fetch data
# ============================================================

@step fetch_data -> raw_data
    request GET {{base_url}}/posts/1

# ============================================================
# STEP 2: Process data
# ============================================================

@step process <- fetch_data -> processed_data
    func Process Data

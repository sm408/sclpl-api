{
  "id": "minimal-workflow",
  "name": "Minimal Workflow",
  "description": "A minimal workflow template. Replace with your own logic.",
  "steps": [
    {
      "id": "fetch_data",
      "name": "fetch_data",
      "type": "request",
      "config": {
        "inline_request": {
          "method": "GET",
          "url": "{{base_url}}/posts/1",
          "headers": {}
        }
      },
      "output_variable": "raw_data"
    },
    {
      "id": "process",
      "name": "process",
      "type": "function",
      "config": {
        "function_name": "Process Data"
      },
      "depends_on": [
        "fetch_data"
      ],
      "output_variable": "processed_data"
    }
  ],
  "variables": {
    "base_url": "https://jsonplaceholder.typicode.com"
  }
}

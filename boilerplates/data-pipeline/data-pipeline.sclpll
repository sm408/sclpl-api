# Data Pipeline Template
# Fetch, transform, and load data in a multi-stage pipeline

@workflow data-pipeline "Data Pipeline"
    A data pipeline template with fetch, transform, and load stages.
    Customize each stage for your specific data workflow.

@base_url https://jsonplaceholder.typicode.com

# ============================================================
# PHASE 1: Extract (fetch raw data in parallel)
# ============================================================

@step fetch_users -> raw_users
    request GET {{base_url}}/users

@step fetch_posts -> raw_posts
    request GET {{base_url}}/posts

@step fetch_comments -> raw_comments
    request GET {{base_url}}/comments?_limit=50

# ============================================================
# PHASE 2: Transform (process and merge data)
# ============================================================

@step transform_users <- fetch_users -> transformed_users
    func Transform Data

@step transform_posts <- fetch_posts, fetch_comments -> transformed_posts
    func Transform Data

# ============================================================
# PHASE 3: Load (combine into final output)
# ============================================================

@step load <- transform_users, transform_posts -> final_output
    func Load Data

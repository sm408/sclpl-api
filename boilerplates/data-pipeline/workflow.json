{
  "id": "data-pipeline",
  "name": "Data Pipeline",
  "description": "A data pipeline template with fetch, transform, and load stages.",
  "steps": [
    {
      "id": "fetch_users",
      "name": "fetch_users",
      "type": "request",
      "config": {
        "inline_request": {
          "method": "GET",
          "url": "{{base_url}}/users",
          "headers": {}
        }
      },
      "output_variable": "raw_users"
    },
    {
      "id": "fetch_posts",
      "name": "fetch_posts",
      "type": "request",
      "config": {
        "inline_request": {
          "method": "GET",
          "url": "{{base_url}}/posts",
          "headers": {}
        }
      },
      "output_variable": "raw_posts"
    },
    {
      "id": "fetch_comments",
      "name": "fetch_comments",
      "type": "request",
      "config": {
        "inline_request": {
          "method": "GET",
          "url": "{{base_url}}/comments?_limit=50",
          "headers": {}
        }
      },
      "output_variable": "raw_comments"
    },
    {
      "id": "transform_users",
      "name": "transform_users",
      "type": "function",
      "config": {
        "function_name": "Transform Data"
      },
      "depends_on": [
        "fetch_users"
      ],
      "output_variable": "transformed_users"
    },
    {
      "id": "transform_posts",
      "name": "transform_posts",
      "type": "function",
      "config": {
        "function_name": "Transform Data"
      },
      "depends_on": [
        "fetch_posts",
        "fetch_comments"
      ],
      "output_variable": "transformed_posts"
    },
    {
      "id": "load",
      "name": "load",
      "type": "function",
      "config": {
        "function_name": "Load Data"
      },
      "depends_on": [
        "transform_users",
        "transform_posts"
      ],
      "output_variable": "final_output"
    }
  ],
  "variables": {
    "base_url": "https://jsonplaceholder.typicode.com"
  }
}
